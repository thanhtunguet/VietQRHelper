<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.1</Version>
    <TargetFramework>net6.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>VietQR</RootNamespace>
    <AssemblyName>VietQR</AssemblyName>
    <Deterministic>true</Deterministic>
    <PackageId>VietQR</PackageId>
    <Authors>thanhtunguet</Authors>
    <Company>thanhtunguet</Company>
    <Description>Thư viện tạo mã VietQR cho C# từ 6.0. Dựa trên các dự án nguồn mở xuất sắc, xin gửi lời cảm ơn tới xuannghia/vietnam-qr-pay và nick-hoang/vietnam-qr-pay-csharp.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/thanhtunguet/csharp-vietqr</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.4" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>